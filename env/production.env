# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# These settings are for production deployment
# Set these values before deploying to production
# =============================================================================

# Required: Backend API URL (production)
VITE_API_URL=https://rtxbackend.tradecopier.org
VITE_FIX_API_URL=https://rtxbackend.tradecopier.org

# Local MT5 Sync API Server (usually runs on user's machine, or remote)

# Required: WebSocket URL (production)
VITE_WS_URL=wss://fixapibackend.tradecopier.org/ws
VITE_FIX_WS_URL=wss://fixapibackend.tradecopier.org/ws
VITE_MARKET_WS_URL=wss://fixapibackend.tradecopier.org/ws

# Optional: Admin API URL (production)
VITE_ADMIN_URL=https://rtxbackend.tradecopier.org

# Optional: Admin WebSocket URL (production)
VITE_ADMIN_WS_URL=

# Optional: Enable debug logging (should be false in production)
VITE_ENABLE_DEBUG=false
