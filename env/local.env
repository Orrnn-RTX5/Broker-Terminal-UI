# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
# These settings are for local development only
# =============================================================================

# Required: Backend API URL (local development)
VITE_API_URL=https://rtxbackend.tradecopier.org

# Required: WebSocket URL (local development)
VITE_WS_URL=wss://fixapibackend.tradecopier.org/ws
VITE_FIX_WS_URL=wss://fixapibackend.tradecopier.org/ws
VITE_MARKET_WS_URL=wss://fixapibackend.tradecopier.org/ws

# Optional: Admin API URL (local development)
VITE_ADMIN_URL=http://localhost:7999

# Optional: Admin WebSocket URL (local development)
VITE_ADMIN_WS_URL=ws://localhost:7999/admin-ws

# Optional: Enable debug logging
VITE_ENABLE_DEBUG=true
