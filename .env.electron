# Desktop installer starts with Achiever Financials. Other brokers remain selectable in the login directory.
# Rebuild with npm run build:electron and package/reinstall after changing this file.
BACKEND_TARGET=electron
VITE_BACKEND_TARGET=electron
VITE_BACKEND_MODE=electron

VITE_BACKEND_URL=https://service.achieverfinancials.com
VITE_API_URL=https://service.achieverfinancials.com
VITE_RTX5_API_URL=https://service.achieverfinancials.com
VITE_FIX_API_URL=https://service.achieverfinancials.com
VITE_API_HOST=https://service.achieverfinancials.com
VITE_API_HOST_EXT=https://service.achieverfinancials.com

VITE_WS_URL=wss://service.achieverfinancials.com/ws/v2
VITE_FIX_WS_URL=wss://service.achieverfinancials.com/ws/v2
VITE_MARKET_WS_URL=wss://service.achieverfinancials.com/ws/v2
VITE_WS_HOST=wss://service.achieverfinancials.com

VITE_BROKER_DISCOVERY_URL=https://superbackend.orrnn.com
VITE_DISCOVERY_BASE_URL=https://superbackend.orrnn.com
VITE_DEFAULT_MT5_SERVER=Achiever Financials
VITE_BROKER_ID=achiever-financials
VITE_FEED_BROKER_ID=achiever-financials
VITE_USE_MOCK_DISCOVERY=false
VITE_ENABLE_DEBUG=false
VITE_FEED_BROKER_TOKEN=
