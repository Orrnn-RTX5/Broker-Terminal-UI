# Public settings for ONE registered broker; reusable with the SAME Docker image.
# Copy to .env (or pass --env-file). Replace placeholders with backend-provisioned values.
# Backend manager/server passwords, private keys and privileged tokens MUST stay in the backend env.
BACKEND_TARGET=web
API_HOST=https://api.your-broker.example
WS_HOST=wss://api.your-broker.example
BROKER_ID=your-exact-registered-broker-id
# Required: supply the actual trading-server setting from backend provisioning.
DEFAULT_MT5_SERVER=

# Optional: empty uses API_HOST, never a different broker.
API_HOST_EXT=
# Optional discovery catalog origin, without /api/v2/broker/servers; both must agree.
DISCOVERY_BASE_URL=
BROKER_DISCOVERY_URL=
# Optional: empty uses BROKER_ID.
FEED_BROKER_ID=
PUBLIC_MARKET_API=gateway-v2
PUBLIC_CANDLE_BRIDGE=false
USE_MOCK_DISCOVERY=false

# Optional public presentation; never inferred from broker name/domain.
BROKER_NAME=
BROKER_LOGO_URL=
BROKER_LOGIN_HERO_URL=
BROKER_LOGIN_HERO_MOBILE_URL=
BROKER_TERMS_URL=
# Asset/terms URLs, when set, must be public HTTPS URLs without embedded credentials.
# Empty hero URL uses neutral shared artwork; empty terms URL shows no unrelated legal link.

# Comma-separated HTTPS origins only if separate API/WS services are explicitly required.
BROKER_ALLOWED_ORIGINS=
