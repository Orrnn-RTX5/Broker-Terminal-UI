# RTX5 Web Terminal - Example Environment Configuration
# Copy this file to .env.web for local development only.
# Production environments are configured dynamically via GitHub Secrets.

BACKEND_TARGET=web
VITE_BACKEND_TARGET=web
VITE_BACKEND_MODE=web

# Broker Backend API
VITE_BACKEND_URL=https://service.yourbroker.com
VITE_API_URL=https://service.yourbroker.com
VITE_RTX5_API_URL=https://service.yourbroker.com
VITE_FIX_API_URL=https://service.yourbroker.com
VITE_API_HOST=https://service.yourbroker.com

# Live Market Data WebSocket
VITE_WS_URL=wss://service.yourbroker.com/ws/v2
VITE_FIX_WS_URL=wss://service.yourbroker.com/ws/v2
VITE_MARKET_WS_URL=wss://service.yourbroker.com/ws/v2
VITE_WS_HOST=wss://service.yourbroker.com

# SuperAdmin Discovery
VITE_BROKER_DISCOVERY_URL=https://superadmin.yourbroker.com
VITE_DISCOVERY_BASE_URL=https://superadmin.yourbroker.com

# Broker Branding
VITE_DEFAULT_MT5_SERVER=YourServer
VITE_BROKER_ID=your_broker_id
VITE_FEED_BROKER_ID=your_broker_id
VITE_USE_MOCK_DISCOVERY=false
VITE_ENABLE_DEBUG=false
