openapi: 3.0.3
info:
  title: Trading Engine RTX - API Documentation
  description: |
    Complete REST API documentation for Trading Engine RTX.

    ## Architecture
    - **Gateway Backend** (Port 7999) - Main API entry point
    - **FIX API Backend** (Port 8081) - FIX protocol market data

    ## Authentication
    Use the `/api/login` endpoint to get a Bearer token, then include it in all protected requests:
    `Authorization: Bearer <your_token>`
  version: 1.0.0
  contact:
    name: RTX Trading Engine

# Apply BearerAuth to ALL endpoints by default
# Public endpoints override this with: security: []
security:
  - BearerAuth: []

servers:
  - url: http://localhost:7999
    description: Gateway Backend (Main)
  - url: http://localhost:8081
    description: FIX API Backend

tags:
  - name: Health
    description: Service health check endpoints
  - name: Auth
    description: Authentication - Login, Logout, Refresh
  - name: Market Data
    description: Public market data - symbols, quotes, candles, ticks
  - name: Account
    description: Trading account info - balance, history, equity
  - name: Trading
    description: Order and position management

components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:
    LoginRequest:
      type: object
      required: [username, password]
      properties:
        username:
          type: string
          example: "900767"
        password:
          type: string
          example: "47Y$Gj&0YS@T"

    LoginResponse:
      type: object
      properties:
        access_token:
          type: string
          example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        refresh_token:
          type: string
        expires_at:
          type: string
          format: date-time
        user:
          type: object
          properties:
            id:
              type: string
            username:
              type: string
            email:
              type: string
            role:
              type: string
              example: "trader"

    CreateOrderRequest:
      type: object
      required: [symbol, type, side, quantity]
      properties:
        symbol:
          type: string
          example: "EURUSD"
        type:
          type: string
          enum: [market]
          example: "market"
        side:
          type: string
          enum: [buy, sell]
          example: "buy"
        quantity:
          type: number
          example: 0.01
        price:
          type: number
          example: 0
        account_login:
          type: integer
          example: 900767

    Order:
      type: object
      properties:
        id:
          type: string
        symbol:
          type: string
        type:
          type: string
        side:
          type: string
        quantity:
          type: number
        price:
          type: number
        status:
          type: string
          enum: [pending, filled, cancelled, rejected]
        created_at:
          type: string
          format: date-time
        mt5_order_id:
          type: integer
        mt5_deal_id:
          type: integer

    Position:
      type: object
      properties:
        ticket:
          type: integer
          format: int64
          example: 1000001
        account_login:
          type: integer
          format: int64
          example: 100001
        symbol:
          type: string
          example: EURUSD
        side:
          type: string
          enum: [buy, sell]
          example: buy
        volume:
          type: number
          format: double
          example: 1.00
        price_open:
          type: number
          format: double
          example: 1.08650
        price_current:
          type: number
          format: double
          example: 1.08750
        price_sl:
          type: number
          format: double
          nullable: true
        price_tp:
          type: number
          format: double
          nullable: true
        profit:
          type: number
          format: double
          example: 100.00
        swap:
          type: number
          format: double
          example: -1.50
        commission:
          type: number
          format: double
          example: -7.00
        comment:
          type: string
        time_create:
          type: integer
          format: int64
        time_update:
          type: integer
          format: int64
        trailing_stop:
          type: integer
          description: Trailing stop distance in points (0 = disabled)
          example: 50
        trailing_step:
          type: integer
          description: Minimum move in points before trailing adjusts
          example: 10
        magic:
          type: integer
          format: int64
          description: Expert Advisor magic number (0 = manual trade)
          example: 0

    Deal:
      type: object
      properties:
        ticket:
          type: integer
          format: int64
        order_ticket:
          type: integer
          format: int64
          description: Related order ticket
        position_ticket:
          type: integer
          format: int64
          description: Related position ticket
        account_login:
          type: integer
          format: int64
        symbol:
          type: string
        action:
          type: string
          enum: [deal_buy, deal_sell, deal_balance, deal_credit, deal_commission, deal_correction]
        entry:
          type: string
          enum: [entry_in, entry_out, entry_inout]
          description: "entry_in = opening side, entry_out = closing side, entry_inout = close-by"
        volume:
          type: number
          format: double
        price:
          type: number
          format: double
        profit:
          type: number
          format: double
        swap:
          type: number
          format: double
        commission:
          type: number
          format: double
        fee:
          type: number
          format: double
        magic:
          type: integer
          format: int64
          description: EA magic number (0 if manual)
        comment:
          type: string
        time:
          type: integer
          format: int64

    Error:
      type: object
      required: [error, message]
      properties:
        error:
          type: string
          example: VALIDATION_ERROR
        message:
          type: string
          example: Invalid request parameters

    AccountSummary:
      type: object
      properties:
        id:
          type: string
        balance:
          type: number
          example: 10300.25
        equity:
          type: number
        margin_used:
          type: number
        margin_available:
          type: number
        unrealized_pl:
          type: number
        realized_pl:
          type: number
        open_positions:
          type: integer
        pending_orders:
          type: integer
        currency:
          type: string
          example: "USD"
        leverage:
          type: integer
          example: 100

    HealthResponse:
      type: object
      properties:
        status:
          type: string
          example: "healthy"
        timestamp:
          type: integer
        version:
          type: string

    ErrorResponse:
      type: object
      properties:
        error:
          type: string
        message:
          type: string

paths:

  # ===== HEALTH =====
  /health:
    get:
      tags: [Health]
      summary: Gateway Health Check
      description: Check if Gateway Backend (port 7999) is running
      security: []   # Public - no token needed
      responses:
        '200':
          description: Service is healthy
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HealthResponse'

  # ===== AUTH =====
  /api/login:
    post:
      tags: [Auth]
      summary: Login - Get Bearer Token
      security: []   # Public - this is how you GET the token
      description: |
        Login with credentials to get access_token.
        Use the token in `Authorization: Bearer <token>` header for all protected endpoints.

        **Default credentials (from .env):**
        - username: `900767`
        - password: `47Y$Gj&0YS@T`
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
      responses:
        '200':
          description: Login successful - contains access_token
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
        '401':
          description: Invalid credentials
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'

  /api/logout:
    post:
      tags: [Auth]
      summary: Logout
      security: []   # Public - users can logout without a valid token
      responses:
        '200':
          description: Logged out successfully

  /api/refresh:
    post:
      tags: [Auth]
      summary: Refresh Access Token
      security: []   # Public - used to renew an expired access token
      description: Get a new access_token using a refresh_token (before expiry)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                refresh_token:
                  type: string
      responses:
        '200':
          description: New access_token returned
        '401':
          description: Invalid or expired refresh token

  # ===== MARKET DATA (PROTECTED) =====
  /api/symbols:
    get:
      tags: [Market Data]
      summary: Get All Trading Symbols
      description: Returns list of all available trading symbols.
      responses:
        '200':
          description: List of symbols

  /api/v2/quotes:
    get:
      tags: [Market Data]
      summary: Get quotes for multiple symbols
      description: Get latest quotes for one or more trading symbols.
      parameters:
        - name: symbols
          in: query
          required: false
          schema:
            type: string
            example: EURUSD,GBPUSD
          description: Comma-separated symbol list
      responses:
        '200':
          description: Quotes

  /api/candles/{symbol}:
    get:
      tags: [Market Data]
      summary: Get Historical Candles (OHLCV)
      description: Get historical OHLCV candle data for charting
      parameters:
        - name: symbol
          in: path
          required: true
          schema:
            type: string
            example: EURUSD
        - name: timeframe
          in: query
          schema:
            type: string
            example: H1
            enum: [M1, M5, M15, M30, H1, H4, D1, W1, MN]
        - name: count
          in: query
          schema:
            type: integer
            example: 100
      responses:
        '200':
          description: Candle data array

  /api/ticks/{symbol}:
    get:
      tags: [Market Data]
      summary: Get Tick Data
      description: Get raw tick data for a symbol
      parameters:
        - name: symbol
          in: path
          required: true
          schema:
            type: string
            example: EURUSD
      responses:
        '200':
          description: Tick data array

  # ===== ACCOUNT INFO =====
  /api/account/summary:
    get:
      tags: [Account]
      summary: Account Summary
      description: Get current account balance, equity, margin, open positions count
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Account summary data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AccountSummary'

  /api/account/transactions:
    get:
      tags: [Account]
      summary: Transaction History
      description: Get list of all account transactions (deposits, withdrawals, trades, fees)
      security:
        - BearerAuth: []
      parameters:
        - name: type
          in: query
          description: Filter by transaction type
          schema:
            type: string
            enum: [deposit, withdrawal, trade, fee, commission]
        - name: limit
          in: query
          schema:
            type: integer
            example: 50
      responses:
        '200':
          description: Transaction list

  /api/account/equity-history:
    get:
      tags: [Account]
      summary: Equity History (Chart Data)
      description: Get equity curve data for portfolio performance chart
      security:
        - BearerAuth: []
      parameters:
        - name: period
          in: query
          schema:
            type: string
            enum: [1d, 7d, 30d, 90d, 1y]
            example: 30d
        - name: interval
          in: query
          schema:
            type: string
            example: 1d
      responses:
        '200':
          description: Equity history with statistics

  # ===== TRADING =====
  /api/orders:
    get:
      tags: [Trading]
      summary: Get All Orders
      security:
        - BearerAuth: []
      responses:
        '200':
          description: List of orders
          content:
            application/json:
              schema:
                type: object
                properties:
                  orders:
                    type: array
                    items:
                      $ref: '#/components/schemas/Order'
                  count:
                    type: integer

    post:
      tags: [Trading]
      summary: Place Market Order
      description: |
        Place a market buy or sell order through the trading gateway.

        **Note:** Only `market` order type is currently supported.
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateOrderRequest'
      responses:
        '201':
          description: Order placed and filled
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Order'
        '400':
          description: Invalid request or unsupported order type

  /api/orders/{id}:
    delete:
      tags: [Trading]
      summary: Cancel Order
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Order cancelled
        '404':
          description: Order not found

  /api/v2/positions/{login}:
    get:
      operationId: getPositions
      tags: [Trading]
      summary: Get open positions for an account
      security:
        - BearerAuth: []
      parameters:
        - name: login
          in: path
          required: true
          schema:
            type: integer
            format: int64
        - name: limit
          in: query
          schema:
            type: integer
            default: 50
        - name: offset
          in: query
          schema:
            type: integer
            default: 0
      responses:
        '200':
          description: Open positions
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Position'

  /api/v2/positions/{id}/close:
    post:
      operationId: closePosition
      tags: [Trading]
      summary: Close a specific position by ticket
      description: |
        The position must belong to an account owned by the authenticated user.
        Uses a DB transaction for atomicity. Rejected if market data returns zero or negative prices.
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
            format: int64
      responses:
        '200':
          description: Position closed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Deal'
        '404':
          description: Position not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '429':
          description: Rate limited - too many requests. Check Retry-After header.

