{
  "_comment": "Schema reference only. The deploy pipeline reads the real broker manifest from the ORRNN-RTX5-Broker-Infra repo (or the BROKERS_JSON secret) at deploy time — NOT from this file. Do not commit live SSH hosts, users, ports, or internal IPs here.",
  "brokers": [
    {
      "id": "grow-trading-academy",
      "name": "Grow Trading Academy",
      "enabled": true,
      "domain": "webterminal.growtradingacademy.com",
      "backend_url": "https://services.growtradingacademy.com",
      "env": {
        "BACKEND_TARGET": "web",
        "API_HOST": "https://services.growtradingacademy.com",
        "API_HOST_EXT": "https://services.growtradingacademy.com",
        "WS_HOST": "wss://services.growtradingacademy.com",
        "DEFAULT_MT5_SERVER": "RTX 5 Web Terminal",
        "DISCOVERY_BASE_URL": "https://superbackend.orrnn.com",
        "USE_MOCK_DISCOVERY": "false"
      },
      "services": {
        "frontend": {
          "container_name": "rtx5-webterminal-grow-trading-academy",
          "health_path": "/"
        },
        "backend_env": {
          "VITE_APP_MODE": "web-terminal",
          "VITE_BROKER_ID": "grow-trading-academy"
        }
      }
    }
  ]
}
