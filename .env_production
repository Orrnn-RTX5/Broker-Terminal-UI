# Required: Backend API URLs (production)
VITE_BACKEND_URL=https://backend.orrnn.com
VITE_API_URL=https://backend.orrnn.com
VITE_RTX5_API_URL=https://backend.orrnn.com
VITE_FIX_API_URL=https://backend.orrnn.com
 
# Required: WebSocket URLs (production)
VITE_WS_URL=wss://backend.orrnn.com/ws/v2
VITE_FIX_WS_URL=wss://backend.orrnn.com/ws/v2
VITE_MARKET_WS_URL=wss://backend.orrnn.com/ws/v2
 
# Optional: Admin API URL (production)
VITE_ADMIN_URL=https://backend.orrnn.com
 
# Optional: Admin WebSocket URL (production)
# Left unset on purpose: useWebSocket falls back to MARKET_WS_URL only when this
# is undefined, whereas an empty value passes "" through and skips the fallback.
# VITE_ADMIN_WS_URL=

# Optional: Enable debug logging (should be false in production)
VITE_ENABLE_DEBUG=false